# Second Brain — configuration
#
# /setup copies this file to config.env (gitignored) and fills it in with you,
# so you normally never edit it by hand. Every variable here is something
# /setup asks about. To change a value later, edit config.env and re-run /setup.
#
# config.env is loaded into Claude's context in every session (CLAUDE.md
# imports it). Never put secrets (API keys, tokens, passwords) in it.
# Use absolute paths, quoted.

# REQUIRED. Your knowledge base: an Obsidian vault folder. /setup creates it if
# it doesn't exist yet. Keep it outside this repo.
VAULT_PATH=""

# OPTIONAL. Folder with your own study material (PDFs, lecture scripts, books)
# for /ingest and /tutor. Leave empty if you don't have one.
SOURCES_PATH=""

# Language of every generated note, card, and quiz. Technical terms from sources
# in other languages are kept as searchable aliases.
CONTENT_LANGUAGE="English"

# true = also `git push` the vault after each automatic commit. Only if the
# vault's git remote is PRIVATE: it holds your notes, quiz history and profile.
VAULT_GIT_PUSH="false"
